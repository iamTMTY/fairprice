# FairPrice settings. Copy this file to .env and change what you need; everything is optional.
# Variables already set in your shell win over this file. Never commit .env (it may hold secrets).
# Relative paths (FAIRPRICE_DB, FAIRPRICE_REPORTS, sqlite:///data/...) are relative to the project folder.

# The AI model, as provider:model (LangChain init_chat_model). Default: ollama:gemma4
# FAIRPRICE_MODEL=ollama:gemma4

# Or your own OpenAI-compatible server (LM Studio, llama-server, mlx_lm.server, vLLM, ...), with
# FAIRPRICE_MODEL=openai:<model name>. Run `uv sync --extra openai-compatible` once. See README, step 2.
# FAIRPRICE_MODEL_URL=http://localhost:1234/v1
# FAIRPRICE_MODEL_API_KEY=

# Where Ollama runs, if not on this computer (the same setting Ollama's own tools use)
# OLLAMA_HOST=http://gpu-server:11434

# Prices for working out API fees per run, only for a paid model provider (a local model costs nothing)
# FAIRPRICE_PRICE_PER_MILLION_INPUT_TOKENS=0
# FAIRPRICE_PRICE_PER_MILLION_OUTPUT_TOKENS=0
# FAIRPRICE_PRICE_CURRENCY=USD

# The procurement database built by `uv run fairprice-ingest`. Default: data/fairprice.duckdb
# FAIRPRICE_DB=/path/to/fairprice.duckdb

# Where the audit log is kept, as a SQLAlchemy URL. Default: sqlite:///data/runs.sqlite
# For Postgres, install a driver first (uv add "psycopg[binary]"). Tested on SQLite only.
# FAIRPRICE_SQL_URL=postgresql+psycopg://user:password@host:5432/fairprice

# The report file format: xlsx (default), csv or json. `--format` overrides it for one run.
# FAIRPRICE_REPORT_FORMAT=csv

# Where reports are kept: file (default, this computer) or s3 (S3-compatible object storage, see below)
# FAIRPRICE_STORAGE=s3

# file storage: the folder for reports. Default: reports/
# FAIRPRICE_REPORTS=/path/to/reports

# S3-compatible object storage, used only when FAIRPRICE_STORAGE=s3 (run `uv sync --extra s3` once).
# Reports can hold confidential bid prices: use storage you run yourself (e.g. MinIO on your own servers),
# or a cloud provider only if your procurement and data rules allow it. The AWS_* names are the standard
# settings for every S3-compatible store, not only AWS.
# FAIRPRICE_S3_BUCKET=fairprice
# FAIRPRICE_S3_PREFIX=fairprice/reports/
# AWS_ENDPOINT_URL=http://minio.internal:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Set to 1 to open the draft report automatically in Excel or Numbers (off by default)
# FAIRPRICE_OPEN_DRAFT=1
